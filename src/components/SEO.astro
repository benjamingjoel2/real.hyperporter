---
import { IS_PRODUCTION } from '../lib/site.mjs';

interface Props {
  title: string;
  description: string;
  /** Absolute override; defaults to the canonical URL for the current request. */
  canonical?: string;
  /**
   * Share image. Absolute, or root-relative and resolved against the site
   * origin. Defaults to the sitewide card (public/og.png, drawn from the
   * homepage hero — see scripts/og/card.html).
   *
   * Per-destination images are still open: they need the landmark SVGs
   * rasterised, which is a larger job. Until then every page shares the one
   * card, which is far better than the bare text card a missing og:image
   * produces on LinkedIn, Slack and X.
   */
  ogImage?: string;
  /** Describes the share image for screen readers. */
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  /** Renders a noindex,nofollow robots tag. Destinations default to true — see src/content/config.ts. */
  noindex?: boolean;
}

const {
  title,
  description,
  canonical = new URL(Astro.url.pathname, Astro.site).toString(),
  ogImage = '/og.png',
  ogImageAlt = 'Hyperporter — run trips on autopilot. Autopilot software and the Horizon operator network, across 137 countries.',
  ogType = 'website',
  noindex = false,
} = Astro.props;

// og:image must be absolute — every consumer of it is off-origin, and a
// root-relative path silently yields no preview at all.
const ogImageUrl = new URL(ogImage, Astro.site).toString();

const pageTitle = `${title} — Hyperporter`;

// A page is indexable only on a production deployment. Vercel publishes every
// preview and branch at its own crawlable URL; without this each one is a
// complete copy of the site competing with production. Per-page `noindex`
// still wins on top of that.
const robotsNoindex = noindex || !IS_PRODUCTION;
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{robotsNoindex && <meta name="robots" content="noindex,nofollow" />}

<meta property="og:type" content={ogType} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:site_name" content="Hyperporter" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={ogImageAlt} />

<slot name="structured-data" />
